# 브라우저용 publishable 키. **비밀이 아니다** — 빌드된 JS에 그대로 들어가고
# 공개 사이트에서 보인다. 스펙 7.2: "publishable 키는 비밀이 아니다 —
# 브라우저에 노출되도록 설계된 키다."
#
# 실제 방어는 RLS다. supabase/migrations/2026-11-17-page-direct-read.sql이
# 컬럼 단위 grant와 정책을 그리고, scripts/verify_anon_access.sh가 실측한다.
#
# secret 키는 여기 두지 않는다. Vite는 VITE_ 접두사가 붙은 변수만
# 클라이언트에 넣으므로, 접두사 없는 SUPABASE_SECRET_KEY는 들어갈 경로가 없다.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
