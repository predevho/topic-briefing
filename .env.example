# Claude API — Max 크레딧이 연결된 Console 조직에서 발급한 키여야 한다
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — 대시보드 Settings > API Keys
#
# 키 이름이 2025년에 바뀌었다. 지금은 publishable / secret이고,
# anon / service_role은 레거시이며 2026년 말에 폐지된다.
# 새 키는 짧은 문자열이다 — eyJ로 시작하는 긴 JWT를 복사하라는 안내는
# 레거시 키용으로 쓰인 것이다.
#
# Postgres 역할 이름은 바뀌지 않았다. RLS 정책은 여전히 anon /
# authenticated / service_role을 대상으로 쓴다.
#   publishable 키 → anon 역할 (로그인 전) 또는 authenticated (로그인 후)
#   secret 키      → service_role (RLS를 우회한다)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# 브라우저용(publishable). 비밀이 아니다 — 브라우저에 노출되도록 설계된 키다.
# 계획 1에서도 필요하다: scripts/verify_anon_access.sh 가 이 키로
# "본문이 anon에게 막히는지"를 확인한다. 그게 요구사항 D2의 검증 수단이다.
# Connect 다이얼로그는 이것을 SUPABASE_KEY 라는 이름으로 준다 — 값은 같다.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 배포된 페이지 주소. 카톡 메시지의 링크 둘이 이 호스트로 간다.
#   [전체 보기] 버튼   → PAGE_URL/<날짜>  그날 브리핑
#   하단 "IT 브리핑 >" → PAGE_URL/         전체 목록 (콘솔이 경로를 무시한다)
# 카카오 개발자 콘솔의 [제품 링크 관리] → [웹 도메인]에 **같은 호스트**를
# 등록해야 한다. 등록하지 않으면 발송은 성공하는데 링크만 죽는다.
PAGE_URL=https://xxxxx.vercel.app

# 카카오 "나에게 보내기". 개발자 콘솔 [앱 키]의 REST API 키와
# [카카오 로그인] → [보안]의 Client Secret이다. refresh_token은 여기 두지 않는다
# — scripts/kakao_auth.py가 Supabase의 kakao_auth 테이블에 넣는다(회전되므로).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 경고 전용 슬랙 채널. 카카오 토큰이 만료되면 카톡으로는 그 사실을 알릴 수
# 없으므로, 만료가 없는 채널이 하나 필요하다. Incoming Webhook으로 발급한다.
# **이 URL은 그 자체가 비밀이다** — 가진 사람은 누구나 채널에 글을 쓸 수 있다.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# 크레딧 가드의 월 예산(USD). Anthropic은 잔여 크레딧을 알려주지 않으므로
# 우리 사용량(runs의 토큰 × 정가)을 이 값과 비교해 80%를 넘으면 알린다.
# 어림(2026-11-18): 1회 $0.7~1.4, 평일 월 22회면 $16~32. 첫 주 실측으로 고친다.
# 비워 두면 예산 대비 경고만 생략된다(급증 경고는 그대로).
MONTHLY_BUDGET_USD=30
